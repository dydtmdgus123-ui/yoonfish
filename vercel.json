{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 10,
      "includeFiles": "{../main.py,../points_data.py,../weather_service.py}"
    },
    "api/recommend.py": {
      "maxDuration": 10,
      "includeFiles": "{../main.py,../points_data.py,../weather_service.py}"
    },
    "api/config.py": {
      "maxDuration": 10,
      "includeFiles": "{../main.py,../points_data.py,../weather_service.py}"
    },
    "api/health.py": {
      "maxDuration": 10,
      "includeFiles": "{../main.py,../points_data.py,../weather_service.py}"
    }
  },
  "rewrites": [
    { "source": "/api/config.js", "destination": "/api/config" }
  ]
}
